# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/smart_doctor_queue

# JWT Authentication
JWT_SECRET=super_secret_key_change_me_in_production
